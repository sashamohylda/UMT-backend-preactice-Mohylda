{
    "openapi": "3.0.0",
    "info": {
        "title": "UMT Bouquets API",
        "version": "1.0.0",
        "description": "Backend API for the bouquets catalogue frontend"
    },
    "servers": [
        {
            "url": "http://localhost:3001",
            "description": "Local development"
        }
    ],
    "paths": {
        "/api/bouquets": {
            "get": {
                "summary": "Get paginated bouquet list",
                "tags": [
                    "Bouquets"
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "per-page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 12
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated bouquet list with data and meta"
                    }
                }
            }
        },
        "/api/feedbacks": {
            "get": {
                "summary": "Get all feedbacks",
                "tags": [
                    "Feedbacks"
                ],
                "responses": {
                    "200": {
                        "description": "Array of feedback items"
                    }
                }
            }
        },
        "/api/orders": {
            "post": {
                "summary": "Create a new order",
                "tags": [
                    "Orders"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name",
                                    "phone",
                                    "address"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ann"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+1 (555) 123-4567"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "456 Floral Ave, Sydney NSW 2000 AU"
                                    },
                                    "comment": {
                                        "type": "string",
                                        "example": "Type your message..."
                                    },
                                    "productId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "example": 1,
                                        "description": "Product id when ordering from catalogue; null for general orders"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order created"
                    },
                    "400": {
                        "description": "Validation error"
                    }
                }
            }
        }
    }
}